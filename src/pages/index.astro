---
// Página principal (landing). Solo ensambla el layout y los componentes; el contenido de
// cada sección está dentro de su componente o en los archivos JSON de src/content.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AccesosRapidos from "../components/AccesosRapidos.astro";
import SobreCarrera from "../components/SobreCarrera.astro";
import VideoCarrera from "../components/VideoCarrera.astro";
import PerfilEgreso from "../components/PerfilEgreso.astro";
import Malla from "../components/Malla.astro";
import CampoLaboral from "../components/CampoLaboral.astro";
import Respaldo from "../components/Respaldo.astro";
import Admision from "../components/Admision.astro";
import FAQ from "../components/FAQ.astro";
import Referencias from "../components/Referencias.astro";
import Footer from "../components/Footer.astro";
---

{/* BaseLayout aporta el <head> y la estructura común; lo de adentro va en su <slot />. */}
<BaseLayout>
  <Header />
  {/* id="contenido": destino del enlace "Saltar al contenido principal" (accesibilidad). */}
  <main id="contenido">
    {/* Orden de las secciones, de arriba hacia abajo. */}
    <Hero />
    <AccesosRapidos />
    <SobreCarrera />
    <VideoCarrera />
    <PerfilEgreso />
    <Malla />
    <CampoLaboral />
    <Respaldo />
    <Admision />
    <FAQ />
    <Referencias />
  </main>
  <Footer />
</BaseLayout>

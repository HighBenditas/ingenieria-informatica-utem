---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AccesosRapidos from "../components/AccesosRapidos.astro";
import SobreCarrera from "../components/SobreCarrera.astro";
import VideoCarrera from "../components/VideoCarrera.astro";
import PerfilEgreso from "../components/PerfilEgreso.astro";
import Malla from "../components/Malla.astro";
import CampoLaboral from "../components/CampoLaboral.astro";
import Respaldo from "../components/Respaldo.astro";
import Admision from "../components/Admision.astro";
import FAQ from "../components/FAQ.astro";
import Referencias from "../components/Referencias.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <AccesosRapidos />
    <SobreCarrera />
    <VideoCarrera />
    <PerfilEgreso />
    <Malla />
    <CampoLaboral />
    <Respaldo />
    <Admision />
    <FAQ />
    <Referencias />
  </main>
  <Footer />
</BaseLayout>

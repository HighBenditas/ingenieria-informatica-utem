---
const videoId: string = "VGQ9TptyvuI";
---

<section id="video" class="section container video-section">
  <p class="eyebrow">VIDEO INSTITUCIONAL</p>
  <h2>Escucha a quienes estudian la carrera</h2>
  <div class="video-frame">
    <iframe
      data-video-src={`https://www.youtube-nocookie.com/embed/${videoId}`}
      title="Ingeniería en Informática en la UTEM, video de Admisión UTEM"
      loading="lazy"
      allow="encrypted-media; picture-in-picture"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
    <noscript>
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title="Ingeniería en Informática en la UTEM, video de Admisión UTEM"
        loading="lazy"
        allow="encrypted-media; picture-in-picture"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </noscript>
  </div>
  <p class="small-note">
    Video publicado por Admisión UTEM (YouTube). Contenido institucional, no
    elaborado por el equipo. <a href="#ref-video">[ver fuente]</a>
  </p>
</section>

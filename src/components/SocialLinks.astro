---
import { socialLinks } from "../data/social";
import Facebook from "../assets/social/facebook.svg";
import Instagram from "../assets/social/instagram.svg";
import LinkedIn from "../assets/social/linkedin.svg";
import X from "../assets/social/x.svg";
import YouTube from "../assets/social/youtube.svg";

const icons = {
  facebook: Facebook,
  instagram: Instagram,
  linkedin: LinkedIn,
  x: X,
  youtube: YouTube,
};
---

<nav
  id="redes-sociales"
  class="social-links"
  aria-label="Redes sociales oficiales de UTEM"
>
  {socialLinks.map(({ network, name, url }) => {
    const SocialIcon = icons[network];
    return (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`UTEM en ${name} (abre una pestaña nueva)`}
        title={`UTEM en ${name}`}
      >
        <SocialIcon
          width={23}
          height={23}
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        />
      </a>
    );
  })}
</nav>

<style>
  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #c8d9e8;
    border-radius: 5px;
    text-decoration: none;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  .social-links a:hover {
    color: #fff;
    background: #ffffff14;
    transform: translateY(-3px);
  }
  .social-links a:focus-visible {
    color: #fff;
    background: #ffffff14;
    outline: 3px solid #a2df65;
    outline-offset: 3px;
  }
  .social-links svg {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .social-links a {
      transition: none;
    }
    .social-links a:hover {
      transform: none;
    }
  }
</style>

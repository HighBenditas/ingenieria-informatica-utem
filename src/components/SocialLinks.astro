---
// Lista de redes sociales (red, nombre y enlace), definida en src/data/social.ts.
import { socialLinks } from "../data/social";
// Cada ícono es un archivo SVG que Astro importa como componente.
import Facebook from "../assets/social/facebook.svg";
import Instagram from "../assets/social/instagram.svg";
import LinkedIn from "../assets/social/linkedin.svg";
import X from "../assets/social/x.svg";
import YouTube from "../assets/social/youtube.svg";

// Diccionario: el nombre de la red se asocia con su ícono.
const icons = {
  facebook: Facebook,
  instagram: Instagram,
  linkedin: LinkedIn,
  x: X,
  youtube: YouTube,
};
---

{/* Menú de redes sociales oficiales de la UTEM. aria-label lo nombra para lectores de pantalla. */}
<nav
  id="redes-sociales"
  class="social-links"
  aria-label="Redes sociales oficiales de UTEM"
>
  {/* Un enlace por red. Se busca su ícono en el diccionario según el campo "network". */}
  {socialLinks.map(({ network, name, url }) => {
    const SocialIcon = icons[network];
    // target="_blank" abre en pestaña nueva; rel="noopener noreferrer" evita que la página abierta
    // acceda a esta. aria-label avisa a lectores de pantalla que abre una pestaña nueva.
    return (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`UTEM en ${name} (abre una pestaña nueva)`}
        title={`UTEM en ${name}`}
      >
        {/* fill="currentColor": el ícono toma el color del texto. aria-hidden y focusable="false":
            es decorativo; el nombre lo da el aria-label del enlace. */}
        <SocialIcon
          width={23}
          height={23}
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        />
      </a>
    );
  })}
</nav>

{/* Estilos propios de este componente. */}
<style>
  /* Fila de íconos que se acomoda en varias líneas si no caben. */
  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  /* Cada enlace es un cuadrado de 44 px (tamaño táctil recomendado) con el ícono centrado. */
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #c8d9e8;
    border-radius: 5px;
    text-decoration: none;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }
  /* Al pasar el cursor: se aclara, se agrega un fondo suave y sube 3 px. */
  .social-links a:hover {
    color: #fff;
    background: #ffffff14;
    transform: translateY(-3px);
  }
  /* Con navegación por teclado: mismo efecto y un contorno verde visible. */
  .social-links a:focus-visible {
    color: #fff;
    background: #ffffff14;
    outline: 3px solid #a2df65;
    outline-offset: 3px;
  }
  .social-links svg {
    display: block;
  }
  /* Si la persona pidió menos movimiento en su sistema, se quitan las animaciones. */
  @media (prefers-reduced-motion: reduce) {
    .social-links a {
      transition: none;
    }
    .social-links a:hover {
      transform: none;
    }
  }
</style>

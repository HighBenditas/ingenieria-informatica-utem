---
import { competencies } from "../data/site";
import Cite from "./Cite.astro";
import Icon from "./Icon.astro";
---

<section id="perfil" class="section soft-section">
  <div class="container">
    <p class="eyebrow">TU PERFIL PROFESIONAL</p>
    <div class="split-heading">
      <h2>
        De aprender cómo funciona
        <br />a hacer que funcione.
      </h2>
      <p>
        ¿Qué podrás hacer como ingeniera o ingeniero informático? Explora el
        perfil en palabras sencillas.
      </p>
    </div>
    <div class="competency-grid">
      {competencies.map((item, index) => (
        <article class="competency">
          <div class="competency-top">
            <Icon name={item.icon} />
            <span class="mono">0{index + 1}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <p class="small-note">
      Síntesis del equipo a partir del perfil institucional. Referencia del
      conjunto: <Cite source="carrera" label="Perfil institucional · UTEM · s. f." />
    </p>
  </div>
</section>

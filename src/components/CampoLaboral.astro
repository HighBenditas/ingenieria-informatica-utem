---
import { getCollection } from "astro:content";
import { employmentIndicators } from "../data/site";
import Cite from "./Cite.astro";
const areas = (await getCollection("laboral")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="campo-laboral" class="section dark-section">
  <div class="container work-grid">
    <div class="work-intro">
      <p class="eyebrow">CAMPO LABORAL</p>
      <h2>
        Un mundo digital.
        <span class="title-second">Muchas formas de ser parte.</span>
      </h2>

      <p>
        ¿Dónde podrías trabajar? En organizaciones públicas, privadas y del
        tercer sector.
      </p>
      <a href="#admision" class="text-link light-link">
        Da el siguiente paso <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="work-list">
      {areas.map(({ data }, index) => (
        <article>
          <span class="mono">0{index + 1}</span>
          <div>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
            <a class="work-offers-link" href={data.offersUrl} target="_blank" rel="noopener noreferrer">
              Ver ofertas en Chile <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
      <p class="work-list-source">
        Referencia del conjunto: <Cite source="carrera" label="Perfil institucional · UTEM · s. f." />
      </p>
    </div>
  </div>
  <div class="container work-opportunities">
    <h3>¿Buscas tu primera experiencia laboral?</h3>
    <p>Explora oportunidades de práctica profesional y primeros empleos en Chile.</p>
    <a class="work-offers-link" href="https://firstjob.me/ofertas" target="_blank" rel="noopener noreferrer">
      Ver prácticas y primeros trabajos <span aria-hidden="true">↗</span>
    </a>
    <p class="work-opportunities-hint">En FirstJob, selecciona Chile y los filtros de especialidad adecuados.</p>
    <p class="work-opportunities-hint">Enlaces externos referenciales. Las ofertas, requisitos y ubicaciones dependen de cada empresa y pueden cambiar.</p>
  </div>
  <div class="container">
    {employmentIndicators.length > 0 ? (
      <dl class="indicators">
        {employmentIndicators.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              {item.value} · {item.year} <a href={item.sourceUrl}>Fuente</a>
            </dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="work-note">
        Una decisión informada también considera el futuro laboral. Consulta{" "}
        <a href="https://www.mifuturo.cl/">Mi Futuro del Mineduc</a> para
        explorar indicadores. <Cite source="mifuturo" /> Aquí no mostramos
        cifras sin año estadístico verificable.
      </p>
    )}
  </div>
</section>

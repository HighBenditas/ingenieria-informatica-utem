---
// getImage genera versiones optimizadas de cada imagen (formato y tamaños).
import { getImage } from "astro:assets";
// Lista de imágenes del carrusel (ruta, texto alternativo, autor, etc.), en src/data/hero.ts.
import { heroSlides } from "../data/hero";
import Icon from "./Icon.astro";
// Para cada imagen se genera: formato webp (más liviano), calidad 78, tres anchos (640, 1024 y 1600 px)
// para que cada pantalla descargue el tamaño que necesita. Promise.all las procesa en paralelo.
const images = await Promise.all(heroSlides.map((slide) => getImage({
  src: slide.image, widths: [640, 1024, 1600], width: 1600, height: 900,
  format: "webp", quality: 78,
})));
---

{/* Carrusel del hero. role="region" y aria-roledescription lo identifican como carrusel
    para lectores de pantalla. data-carousel es la marca que usa el script (experience.ts). */}
<div
  class="hero-stage"
  data-carousel
  role="region"
  aria-roledescription="carrusel"
  aria-label="Informática en imágenes"
>
  <div class="hero-slides">
    {/* Una diapositiva por imagen. data-active indica cuál se ve; las demás quedan ocultas
        para lectores de pantalla (aria-hidden) hasta que les toque. */}
    {heroSlides.map((slide, index) => (
      <div
        class="hero-slide"
        data-slide
        data-caption={slide.label}
        data-active={index === 0 ? "true" : "false"}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${index + 1} de ${heroSlides.length}: ${slide.label}`}
        aria-hidden={index !== 0}
      >
        {/* Solo la primera imagen carga de inmediato (src y srcset). Las demás guardan su dirección
            en data-slide-src y data-slide-srcset, y el script las carga después, para acelerar la
            carga inicial. fetchpriority="high" le da prioridad a la primera. alt describe la imagen. */}
        <img
          {...images[index]?.attributes}
          src={index === 0 ? images[index]?.src : undefined}
          srcset={index === 0 ? images[index]?.srcSet.attribute : undefined}
          data-slide-src={index === 0 ? undefined : images[index]?.src}
          data-slide-srcset={index === 0 ? undefined : images[index]?.srcSet.attribute}
          alt={slide.alt}
          sizes="100vw"
          width={1600}
          height={900}
          loading="eager"
          decoding="async"
          fetchpriority={index === 0 ? "high" : "low"}
          style={`object-position: ${slide.position}`}
        />
      </div>
    ))}
  </div>
  {/* Texto principal sobre las imágenes: es el único <h1> de la página. */}
  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="green-dot"></span> INGENIERÍA EN INFORMÁTICA · UTEM
      </p>
      <h1>
        Transforma ideas
        <br />
        en <span>tecnología.</span>
      </h1>
      <p class="hero-description">
        Tu curiosidad es el comienzo. Explora una carrera para entender, crear y
        conectar el mundo digital.
      </p>
      <div class="button-row">
        {/* Botón principal: lleva a la sección "La carrera". */}
        <a class="button hero-primary" href="#carrera">
          Explorar la carrera <Icon name="arrow" size={19} />
        </a>
        <a class="text-link" href="#malla">
          Conoce la malla <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <div class="container hero-bottom">
    {/* Controles del carrusel. Empiezan ocultos (atributo hidden): el script los muestra solo si
        JavaScript funciona, porque sin él no servirían. */}
    <div class="carousel-controls" data-carousel-controls hidden>
      {/* Un botón (punto) por imagen para elegirla. aria-pressed marca la que está activa. */}
      <div class="carousel-dots" role="group" aria-label="Elegir imagen">
        {heroSlides.map((slide, index) => (
          <button
            type="button"
            data-slide-button={index}
            aria-label={`Mostrar imagen ${index + 1}: ${slide.label}`}
            aria-pressed={index === 0}
          >
            <span></span>
          </button>
        ))}
      </div>
      {/* Botón pausar/reproducir: permite detener el cambio automático (accesibilidad).
          El script cambia su texto y su aria-label según el estado. */}
      <button
        type="button"
        class="carousel-play"
        data-play
        aria-label="Pausar carrusel"
      >
        <span aria-hidden="true" data-play-icon>Ⅱ</span>
        <span data-play-label>Pausar</span>
      </button>
    </div>
    {/* Enlace a los créditos de las fotografías (en la sección de referencias). */}
    <a class="hero-credit" href="#creditos-imagenes">
      Fotografías referenciales · Créditos ↗
    </a>
  </div>
  {/* Mensaje invisible: el script escribe aquí qué imagen se muestra, para que lo lea el lector
      de pantalla (aria-live="polite" lo anuncia sin interrumpir). */}
  <p
    class="sr-only"
    data-carousel-announcement
    aria-live="polite"
    aria-atomic="true"
  ></p>
</div>

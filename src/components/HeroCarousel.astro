---
import { getImage } from "astro:assets";
import { heroSlides } from "../data/hero";
import Icon from "./Icon.astro";
const images = await Promise.all(heroSlides.map((slide) => getImage({
  src: slide.image, widths: [640, 1024, 1600], width: 1600, height: 900,
  format: "webp", quality: 78,
})));
---

<div
  class="hero-stage"
  data-carousel
  role="region"
  aria-roledescription="carrusel"
  aria-label="Informática en imágenes"
>
  <div class="hero-slides">
    {heroSlides.map((slide, index) => (
      <div
        class="hero-slide"
        data-slide
        data-caption={slide.label}
        data-active={index === 0 ? "true" : "false"}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${index + 1} de ${heroSlides.length}: ${slide.label}`}
        aria-hidden={index !== 0}
      >
        <img
          {...images[index]?.attributes}
          src={index === 0 ? images[index]?.src : undefined}
          srcset={index === 0 ? images[index]?.srcSet.attribute : undefined}
          data-slide-src={index === 0 ? undefined : images[index]?.src}
          data-slide-srcset={index === 0 ? undefined : images[index]?.srcSet.attribute}
          alt={slide.alt}
          sizes="100vw"
          width={1600}
          height={900}
          loading="eager"
          decoding="async"
          fetchpriority={index === 0 ? "high" : "low"}
          style={`object-position: ${slide.position}`}
        />
      </div>
    ))}
  </div>
  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="green-dot"></span> INGENIERÍA EN INFORMÁTICA · UTEM
      </p>
      <h1>
        Transforma ideas
        <br />
        en <span>tecnología.</span>
      </h1>
      <p class="hero-description">
        Tu curiosidad es el comienzo. Explora una carrera para entender, crear y
        conectar el mundo digital.
      </p>
      <div class="button-row">
        <a class="button hero-primary" href="#carrera">
          Explorar la carrera <Icon name="arrow" size={19} />
        </a>
        <a class="text-link" href="#malla">
          Conoce la malla <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <div class="container hero-bottom">
    <div class="carousel-controls" data-carousel-controls hidden>
      <div class="carousel-dots" role="group" aria-label="Elegir imagen">
        {heroSlides.map((slide, index) => (
          <button
            type="button"
            data-slide-button={index}
            aria-label={`Mostrar imagen ${index + 1}: ${slide.label}`}
            aria-pressed={index === 0}
          >
            <span></span>
          </button>
        ))}
      </div>
      <button
        type="button"
        class="carousel-play"
        data-play
        aria-label="Pausar carrusel"
      >
        <span aria-hidden="true" data-play-icon>Ⅱ</span>
        <span data-play-label>Pausar</span>
      </button>
    </div>
    <a class="hero-credit" href="#creditos-imagenes">
      Fotografías referenciales · Créditos ↗
    </a>
  </div>
  <p
    class="sr-only"
    data-carousel-announcement
    aria-live="polite"
    aria-atomic="true"
  ></p>
</div>

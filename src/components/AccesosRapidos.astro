---
// Datos de admisión (aquí se usa el nombre del proceso, por ejemplo "2027").
import { admissions } from "../data/site";

// Los cinco accesos rápidos: destino dentro de la página (href) y texto visible (label).
// "Campo laboral" va primero porque fue lo más pedido en la encuesta (7 de 8 personas).
const links = [
  { href: "#campo-laboral", label: "Campo laboral" },
  { href: "#malla", label: "Malla curricular" },
  { href: "#perfil", label: "Perfil de egreso" },
  { href: "#admision", label: `Admisión ${admissions.process}` },
  { href: "#preguntas", label: "Preguntas frecuentes" },
];
---

{/* Menú de accesos rápidos bajo el hero. aria-labelledby lo nombra con el título de abajo. */}
<nav class="quick-links container" aria-labelledby="quick-links-title">
  <h2 id="quick-links-title">¿Qué te gustaría conocer?</h2>
  <ul>
    {/* Un enlace por cada elemento de la lista; la flecha ↓ es decorativa (aria-hidden). */}
    {links.map(({ href, label }) => (
      <li>
        <a href={href}>
          {label}
          <span aria-hidden="true">↓</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

{/* Estilos propios de este componente (Astro los aplica solo a él). */}
<style>
  /* Contenedor: espacio vertical y línea superior que lo separa del hero. */
  .quick-links {
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .quick-links h2 {
    font-size: 1rem;
    letter-spacing: -0.02em;
    line-height: 1.4;
    margin-bottom: 14px;
  }
  /* Lista en 5 columnas iguales, sin viñetas. minmax(0, 1fr) evita que una columna desborde. */
  .quick-links ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px 24px;
    padding: 0;
    margin: 0;
  }
  .quick-links li {
    min-width: 0;
  }
  /* Cada enlace: texto a la izquierda y flecha a la derecha; alto mínimo de 48 px para que sea fácil de tocar. */
  .quick-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 10px 8px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .quick-links a span {
    color: var(--blue);
  }
  /* Al pasar el cursor o enfocar con teclado, cambia el color, el fondo y la línea inferior. */
  .quick-links a:hover,
  .quick-links a:focus-visible {
    color: var(--blue);
    background: var(--pale);
    border-bottom-color: var(--blue);
  }
  /* Hasta 900 px de ancho: 2 columnas. El primer acceso (Campo laboral) ocupa toda la fila
     para que los cinco queden ordenados (1 + 2 + 2). */
  @media (max-width: 900px) {
    .quick-links ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .quick-links li:first-child {
      grid-column: 1 / -1;
    }
  }
  /* Hasta 640 px (móvil): menos espacio entre elementos y letra algo más chica. */
  @media (max-width: 640px) {
    .quick-links ul {
      gap: 8px 16px;
    }
    .quick-links a {
      font-size: 0.8rem;
      gap: 8px;
    }
  }
</style>

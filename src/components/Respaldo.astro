---
// Lee la colección "respaldo" (src/content/respaldo.json, validada por un esquema).
import { getCollection } from "astro:content";
// Cita enlazada a las referencias.
import Cite from "./Cite.astro";
// Ordena los reconocimientos según el campo "order".
const items = (await getCollection("respaldo")).sort((a, b) => a.data.order - b.data.order);
// El primero (la acreditación de la universidad) se muestra como tarjeta principal; el resto, al lado.
const [main, ...secondary] = items;
if (!main) throw new Error("Respaldo institucional necesita al menos un registro.");
---

{/* Sección "Respaldo institucional": acreditación de la universidad, certificación de la carrera y sede.
    Los textos y sus fuentes están en src/content/respaldo.json. */}
<section id="respaldo" class="section container">
  <p class="eyebrow">RESPALDO INSTITUCIONAL</p>
  <div class="split-heading">
    <h2>
      Una formación
      <br />
      con respaldo.
    </h2>
    <p>
      Conoce la universidad y distingue los reconocimientos de la institución y
      de la carrera.
    </p>
  </div>
  <div class="backing-grid">
    {/* Tarjeta principal, con la cifra destacada (por ejemplo "5 años") si el registro la tiene. */}
    <article class="accreditation">
      <p class="eyebrow">{main.data.eyebrow}</p>
      {main.data.highlight && (
        <div class="big-number">
          {main.data.highlight.value} <span>{main.data.highlight.unit}</span>
        </div>
      )}
      <h3>{main.data.title}</h3>
      <p>
        {main.data.text}{" "}
        <Cite source={main.data.source.id} />
      </p>
      {/* Nota aclaratoria, si existe. */}
      {main.data.note && <p class="small-note">{main.data.note}</p>}
    </article>
    {/* Tarjetas secundarias: certificación de la carrera y sede. */}
    <div class="backing-secondary">
      {secondary.map(({ data }) => (
        <article>
          <p class="eyebrow">{data.eyebrow}</p>
          <h3>{data.title}</h3>
          <p>
            {data.text} <Cite source={data.source.id} />
          </p>
          {data.note && <p class="small-note">{data.note}</p>}
          {/* Enlace a más información, si el registro lo tiene. */}
          {data.link && (
            <a class="text-link" href={data.link.href}>
              {data.link.label}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
